---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import { useTranslations } from '../../i18n/utils';
import { locales, type Locale } from '../../i18n/config';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

// ?confirmed=1 shows a success banner after redirect from /api/confirm
const confirmed = Astro.url.searchParams.get('confirmed') === '1';
---

<BaseLayout
  title={t('subscribe.title')}
  description={t('subscribe.description')}
  locale={locale}
>
  <!-- Header -->
  <section class="bg-base-200">
    <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10 lg:py-14">
      <div class="max-w-2xl space-y-4">
        <h1 class="font-black tracking-tight text-balance text-4xl sm:text-5xl lg:text-6xl">
          {t('subscribe.title')}
        </h1>
        <p class="text-lg sm:text-xl leading-8 text-base-content/70">
          {t('subscribe.description')}
        </p>
      </div>
    </div>
  </section>

  <!-- Form -->
  <main class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <div class="max-w-lg">
      {confirmed && (
        <div class="alert alert-success mb-8">
          <span>{t('subscribe.confirm.body')}</span>
        </div>
      )}

      <SubscribeForm locale={locale} source="subscribe-page" />
    </div>
  </main>
</BaseLayout>
