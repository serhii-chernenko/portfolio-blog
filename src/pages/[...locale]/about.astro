---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import { locales, type Locale } from '../../i18n/config';

export async function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout
	title={locale === 'en' ? 'About' : 'Про мене'}
	description={locale === 'en'
		? 'A software engineer based in Ukraine writing about engineering, photography, and craft.'
		: 'Інженер-розробник з України, що пише про розробку, фотографію та ремесло.'}
	locale={locale}
>
	<!-- Header section with bg-base-200 -->
	<section class="bg-base-200">
		<div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10 lg:py-14">
			<h1 class="max-w-5xl font-black tracking-tight text-balance text-4xl sm:text-5xl lg:text-6xl">
				{locale === 'en' ? 'About me' : 'Про мене'}
			</h1>
		</div>
	</section>

	<!-- Prose content -->
	<main class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12 lg:py-16">
		<div class="max-w-3xl">
			<Prose>
				{
					locale === 'en' ? (
						<>
							<p>
								I'm Serhii — a software engineer based in Ukraine. I build products for the web and
								write about the craft of doing so.
							</p>
							<p>
								This blog is where I think out loud: about software engineering, the tools I use,
								photography as a practice, and what I'm slowly learning along the way. Posts arrive
								on a personal cadence — no schedule, no quota.
							</p>
							<h2>What I work on</h2>
							<p>
								Mostly full-stack web: TypeScript, React, Node, and increasingly the Cloudflare
								platform. I care about performance, simplicity, and making things that last.
							</p>
							<h2>Contact</h2>
							<p>
								The best way to reach me is by replying to any newsletter email, or finding me on
								GitHub.
							</p>
						</>
					) : (
						<>
							<p>
								Я Сергій — інженер-розробник з України. Будую продукти для вебу і пишу про ремесло
								цієї справи.
							</p>
							<p>
								Цей блог — місце, де я думаю вголос: про розробку програмного забезпечення,
								інструменти, якими користуюся, фотографію як практику та те, що поволі вивчаю.
								Дописи з'являються в моєму власному ритмі — без розкладу й плану.
							</p>
							<h2>Над чим працюю</h2>
							<p>
								Здебільшого повний стек: TypeScript, React, Node і все більше платформа Cloudflare.
								Мені важливі швидкодія, простота та речі, що служать довго.
							</p>
							<h2>Контакт</h2>
							<p>
								Найкращий спосіб зв'язатися — відповісти на будь-який лист із розсилки або знайти
								мене на GitHub.
							</p>
						</>
					)
				}
			</Prose>
		</div>
	</main>
</BaseLayout>
