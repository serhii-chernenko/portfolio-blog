---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, getTagsForLocale, tagSlug } from '../../../lib/posts';
import { useTranslations, localeHref } from '../../../i18n/utils';
import { locales, type Locale } from '../../../i18n/config';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    const tags = await getTagsForLocale(locale);
    for (const { tag } of tags) {
      const slug = tagSlug(tag);
      const posts = await getPublishedPosts(locale);
      const filtered = posts.filter((p) => (p.data.tags ?? []).includes(tag));
      paths.push({
        params: { locale, tag: slug },
        props: { locale, tagLabel: tag, posts: filtered },
      });
    }
  }
  return paths;
}

type Props = {
  locale: Locale;
  tagLabel: string;
  posts: Awaited<ReturnType<typeof getPublishedPosts>>;
};

const { locale, tagLabel, posts } = Astro.props as Props;
const t = useTranslations(locale);
const title = t('tag.title', { tag: tagLabel });
---

<BaseLayout
  title={title}
  description={t('site.description')}
  locale={locale}
>
  <main class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="flex flex-col gap-10">
      <!-- Back + heading -->
      <header class="space-y-4">
        <a
          href={localeHref(locale, 'tags/')}
          class="group/cta inline-flex items-center gap-1.5 btn btn-ghost btn-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cta-icon-left" aria-hidden="true">
            <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>
          </svg>
          {t('tags.title')}
        </a>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h1>
      </header>

      <!-- Posts or empty state -->
      {posts.length === 0 ? (
        <div class="rounded-box border border-base-300 bg-base-100 p-8 text-center sm:p-12">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto size-10 opacity-50 mb-4" aria-hidden="true">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          <h2 class="mt-4 text-xl font-semibold">{t('tag.empty')}</h2>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )}
    </div>
  </main>
</BaseLayout>
