---
import { stegaClean } from '@sanity/client/stega';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import { useTranslations, mirroredLocaleHrefs } from '../../i18n/utils';
import { isLocale } from '../../i18n/config';

export const prerender = false;

const locale = Astro.params.locale ?? '';
if (!isLocale(locale)) return new Response(null, { status: 404 });
const t = useTranslations(locale, Astro.locals.uiOverrides);
---

<BaseLayout
	title={stegaClean(t('subscribe.title'))}
	description={stegaClean(t('subscribe.description'))}
	locale={locale}
	alternates={mirroredLocaleHrefs('subscribe/')}
	pageType="subscribe"
>
	<!-- Header -->
	<section class="bg-base-200">
		<div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10 lg:py-14">
			<div class="max-w-2xl space-y-4">
				<h1 class="font-black tracking-tight text-balance text-4xl sm:text-5xl lg:text-6xl">
					{t('subscribe.title')}
				</h1>
				<p class="text-lg sm:text-xl leading-8 text-base-content/70">
					{t('subscribe.description')}
				</p>
			</div>
		</div>
	</section>

	<!-- Form -->
	<div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
		<div class="max-w-lg">
			<div id="subscribe-confirmed-banner" hidden class="alert alert-success mb-8">
				<span>{t('subscribe.confirm.body')}</span>
			</div>

			<SubscribeForm locale={locale} source="subscribe-page" />
		</div>
	</div>
</BaseLayout>

<script>
	const params = new URLSearchParams(window.location.search);
	if (params.get('confirmed') === '1') {
		const banner = document.getElementById('subscribe-confirmed-banner');
		if (banner) banner.removeAttribute('hidden');
		const url = new URL(window.location.href);
		url.searchParams.delete('confirmed');
		history.replaceState(null, '', url);
	}
</script>
