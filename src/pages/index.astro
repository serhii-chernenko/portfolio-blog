---
// Static landing at /blog/ → meta-refresh to /blog/en/.
// Using a static page instead of Astro.redirect() so the file is prerendered and
// served as a static asset by the Worker (no SSR roundtrip).
import { withBase } from '../i18n/utils';

export const prerender = true;

const target = withBase('en/');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={target} />
		<title>Redirecting…</title>
		<script is:inline define:vars={{ target }}>
			window.location.replace(target);
		</script>
	</head>
	<body>
		<p>Redirecting to <a href={target}>{target}</a>…</p>
	</body>
</html>
