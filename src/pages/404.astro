---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, localeHref } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout
  title={t('404.title')}
  description={t('404.body')}
  locale={locale}
>
  <section class="flex min-h-[90svh] items-center py-16 bg-base-200">
    <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 flex flex-col items-start justify-center grow gap-6">
      <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-widest opacity-50">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
          <path d="M11 8v4M11 15h.01"/>
        </svg>
        404
      </p>
      <div class="max-w-2xl space-y-4">
        <h1 class="max-w-5xl font-black tracking-tight text-balance text-4xl sm:text-5xl lg:text-6xl">
          {t('404.title')}
        </h1>
        <p class="text-lg sm:text-xl leading-8 text-base-content/70">
          {t('404.body')}
        </p>
      </div>
      <a href={localeHref(locale)} class="group/cta btn btn-ghost btn-xs">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cta-icon-left" aria-hidden="true">
          <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>
        </svg>
        {t('404.cta')}
      </a>
    </div>
  </section>
</BaseLayout>
