---
import PostLayout from '../../../../layouts/PostLayout.astro';
import PortableTextBody from '../../../../components/portable-text/PortableTextBody.astro';
import { getPostBySlug } from '../../../../lib/posts';
import { annotateHeadings } from '../../../../lib/portable-text';
import { readingTimeMinutes } from '../../../../lib/reading-time';
import { getCmsContext } from '../../../../lib/cms/context';
import { isLocale } from '../../../../i18n/config';

export const prerender = false;

const locale = Astro.params.locale ?? '';
const slug = Astro.params.slug ?? '';
if (!isLocale(locale)) return new Response(null, { status: 404 });
const post = await getPostBySlug(locale, slug, getCmsContext(Astro.locals));
if (!post) return new Response(null, { status: 404 });

const { headings } = annotateHeadings(post.body);
const readingTime = readingTimeMinutes(post.wordCount);
---

<PostLayout post={post} headings={headings} readingTime={readingTime}>
	<PortableTextBody value={post.body} />
</PostLayout>
