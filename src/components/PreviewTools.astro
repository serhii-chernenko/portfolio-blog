---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { EDIT_MODE_PARAM, PREVIEW_TOKEN_PARAM } from '../lib/cms/config';

export interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale, Astro.locals.uiOverrides);

// Rendered only for draft views (an EmDash preview link or edit mode). Leaving drops the
// signed token, so the same URL shows the published version again.
const exitUrl = new URL(Astro.url);
exitUrl.searchParams.delete(PREVIEW_TOKEN_PARAM);
exitUrl.searchParams.delete(EDIT_MODE_PARAM);
const exitPreviewHref = `${exitUrl.pathname}${exitUrl.search}${exitUrl.hash}`;
---

<a
	id="preview-exit"
	href={exitPreviewHref}
	class="btn btn-neutral btn-sm fixed bottom-4 right-4 z-50 shadow-lg"
>
	{t('preview.exit')}
</a>
