---
import type { Locale } from '../i18n/config';
import { useTranslations, withBase } from '../i18n/utils';
import { getPagePath } from '../lib/pages';
import LanguageSwitcher from './LanguageSwitcher.astro';

export interface Props {
	locale: Locale;
	currentPath?: string;
	translatedUrls?: Partial<Record<Locale, string | null>>;
}

const { locale, currentPath, translatedUrls } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const rssHref = new URL(withBase(`${locale}/rss.xml`), Astro.site).toString();
const privacyHref = await getPagePath('privacy', locale);
const supportHref = await getPagePath('support', locale);
---

<footer
	class="footer sm:footer-horizontal items-center max-sm:justify-center max-sm:gap-4 p-4 mt-16 text-sm light:bg-base-content light:text-base-100 dark:bg-base-100 dark:text-base-content"
>
	<div class="flex flex-wrap items-center justify-between gap-4 w-full max-w-6xl mx-auto">
		<!-- Left: copyright -->
		<p>{t('footer.copyright', { year })}</p>

		<!-- Right: links + lang switcher -->
		<div class="flex items-center gap-4 flex-wrap">
			<a href={privacyHref} class="link link-hover light:opacity-80 light:hover:opacity-100">
				{t('footer.privacy')}
			</a>

			<a
				href={rssHref}
				class="link link-hover flex items-center gap-1 light:opacity-80 light:hover:opacity-100"
				title="RSS Feed"
			>
				<!-- RSS icon -->
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 20 20"
					fill="currentColor"
					class="size-4"
					aria-hidden="true"
				>
					<path
						d="M3.75 3a.75.75 0 0 0-.75.75v.5c0 .414.336.75.75.75H4c6.075 0 11 4.925 11 11v.25c0 .414.336.75.75.75h.5a.75.75 0 0 0 .75-.75V16C17 8.82 11.18 3 4 3h-.25Z"
					></path>
					<path
						d="M3 8.75A.75.75 0 0 1 3.75 8H4a8 8 0 0 1 8 8v.25a.75.75 0 0 1-.75.75h-.5a.75.75 0 0 1-.75-.75V16a6 6 0 0 0-6-6h-.25A.75.75 0 0 1 3 9.25v-.5ZM7 15a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"
					></path>
				</svg>
				{t('footer.rss')}
			</a>

			<a
				href="https://github.com/serhii-chernenko/portfolio-blog"
				class="link link-hover flex items-center gap-1 light:opacity-80 light:hover:opacity-100"
				target="_blank"
				rel="noopener noreferrer"
			>
				<!-- GitHub icon -->
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="currentColor"
					class="size-4"
					aria-hidden="true"
				>
					<path
						d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
					></path>
				</svg>
				{t('footer.source')}
			</a>

			<a
				href={supportHref}
				class="link link-hover flex items-center gap-1 light:opacity-80 light:hover:opacity-100"
			>
				<!-- Ko-fi icon -->
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="currentColor"
					class="size-4"
					aria-hidden="true"
				>
					<path
						d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.673-.709-.665-1.475-1.856-.98-3.171.494-1.316 1.774-1.638 2.87-1.315.795.236 1.234.842 1.536 1.435.334-.596.744-1.114 1.44-1.377 1.096-.323 2.376-.001 2.869 1.315.494 1.315-.271 2.506-.98 3.17zm4.983-5.42h-1.05v3.15h1.05a1.575 1.575 0 1 0 0-3.15z"
					></path>
				</svg>
				{t('footer.support')}
			</a>

			<LanguageSwitcher locale={locale} currentPath={currentPath} translatedUrls={translatedUrls} />
		</div>
	</div>
</footer>
