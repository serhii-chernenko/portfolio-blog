---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import type { LayoutData, NavLink } from '../lib/site';
import LanguageSwitcher from './LanguageSwitcher.astro';

export interface Props {
	locale: Locale;
	currentPath?: string;
	translatedUrls?: Partial<Record<Locale, string | null>>;
	layout: LayoutData;
}

const PLAIN_LINK_CLASS = 'link link-hover light:opacity-80 light:hover:opacity-100';
const ICON_LINK_CLASS =
	'link link-hover flex items-center gap-1 light:opacity-80 light:hover:opacity-100';

const { locale, currentPath, translatedUrls, layout } = Astro.props;
const t = useTranslations(locale, Astro.locals.uiOverrides);
const year = new Date().getFullYear();

function footerHref(link: NavLink): string {
	return link.route === 'rss' ? new URL(link.href, Astro.site).toString() : link.href;
}

function linkTarget(link: NavLink) {
	return link.openInNewTab
		? { target: '_blank', rel: link.isExternal ? 'noopener noreferrer' : undefined }
		: {};
}
---

<footer class="footer sm:footer-horizontal items-center max-sm:justify-center max-sm:gap-4 p-4 mt-16 text-sm light:bg-base-content light:text-base-100 dark:bg-base-100 dark:text-base-content">
	<div class="flex flex-wrap items-center justify-between gap-4 w-full max-w-6xl mx-auto">
		<p>{t('footer.copyright', { year })}</p>

		<div class="flex items-center gap-4 flex-wrap">
			{layout.footer.map((link) => (
				<a
					href={footerHref(link)}
					class={link.icon ? ICON_LINK_CLASS : PLAIN_LINK_CLASS}
					title={link.route === 'rss' ? 'RSS Feed' : undefined}
					{...linkTarget(link)}
				>
					{link.icon === 'rss' && (
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 20 20"
							fill="currentColor"
							class="size-4"
							aria-hidden="true"
						>
							<path d="M3.75 3a.75.75 0 0 0-.75.75v.5c0 .414.336.75.75.75H4c6.075 0 11 4.925 11 11v.25c0 .414.336.75.75.75h.5a.75.75 0 0 0 .75-.75V16C17 8.82 11.18 3 4 3h-.25Z" />
							<path d="M3 8.75A.75.75 0 0 1 3.75 8H4a8 8 0 0 1 8 8v.25a.75.75 0 0 1-.75.75h-.5a.75.75 0 0 1-.75-.75V16a6 6 0 0 0-6-6h-.25A.75.75 0 0 1 3 9.25v-.5ZM7 15a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z" />
						</svg>
					)}
					{link.icon === 'github' && (
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="currentColor"
							class="size-4"
							aria-hidden="true"
						>
							<path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
						</svg>
					)}
					{link.icon === 'support' && (
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="currentColor"
							class="size-4"
							aria-hidden="true"
						>
							<path d="M4 8a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1v1h.5a3.5 3.5 0 1 1 0 7H17a6 6 0 0 1-6 5h-2a6 6 0 0 1-6-6V8Zm13 3v3h.5a1.5 1.5 0 0 0 0-3H17Z" />
							<path d="M8.75 2.5c.69.98.69 1.52 0 2.5-.5.71-.5 1.29 0 2h1.5c-.69-.98-.69-1.52 0-2.5.5-.71.5-1.29 0-2h-1.5Z" />
							<path d="M12.75 2.5c.69.98.69 1.52 0 2.5-.5.71-.5 1.29 0 2h1.5c-.69-.98-.69-1.52 0-2.5.5-.71.5-1.29 0-2h-1.5Z" />
						</svg>
					)}
					{link.label}
				</a>
			))}

			<LanguageSwitcher locale={locale} currentPath={currentPath} translatedUrls={translatedUrls} />
		</div>
	</div>
</footer>
