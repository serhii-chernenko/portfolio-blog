---
import type { Locale } from '../i18n/config';
import { useTranslations, withBase } from '../i18n/utils';

export interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<dialog
	id="search-modal"
	class="modal modal-top sm:modal-middle"
	aria-label={t('search.title')}
	data-locale={locale}
	data-endpoint={withBase('api/search')}
	data-date-locale={locale === 'uk' ? 'uk-UA' : 'en-US'}
	data-hint={t('search.hint')}
	data-loading={t('search.loading')}
	data-empty={t('search.empty')}
	data-error={t('search.error')}
>
	<div class="modal-box w-11/12 max-w-2xl">
		<div class="flex items-center gap-2 mb-3">
			<label class="input w-full">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-4 opacity-60"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.35-4.35"></path>
				</svg>
				<input
					id="search-input"
					type="search"
					class="grow"
					placeholder={t('search.placeholder')}
					autocomplete="off"
					spellcheck="false"
					maxlength="100"
					role="combobox"
					aria-autocomplete="list"
					aria-controls="search-results"
					aria-expanded="false"
					aria-label={t('search.placeholder')}
				/>
			</label>
			<form method="dialog">
				<button class="btn btn-ghost btn-sm btn-circle" aria-label={t('search.close')}>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 20 20"
						fill="currentColor"
						class="size-5"
						aria-hidden="true"
					>
						<path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"></path>
					</svg>
				</button>
			</form>
		</div>
		<p id="search-status" class="px-1 py-2 text-sm text-base-content/60" role="status">
			{t('search.hint')}
		</p>
		<ul
			id="search-results"
			class="menu w-full gap-1 p-0"
			role="listbox"
			aria-label={t('search.results')}
		></ul>
	</div>
	<form method="dialog" class="modal-backdrop">
		<button tabindex="-1">{t('search.close')}</button>
	</form>
</dialog>

<script>
	import { previewAwareHref } from '../lib/preview-links';

	interface SearchResult {
		title: string;
		description: string;
		url: string;
		publishedAt: string;
	}

	const MIN_QUERY_LENGTH = 2;
	const MAX_QUERY_LENGTH = 100;
	const DEBOUNCE_MS = 200;
	const RESULTS_REPORT_DELAY_MS = 1500;
	const ACTIVE_CLASS = 'menu-active';

	const modal = document.getElementById('search-modal') as HTMLDialogElement | null;
	const input = document.getElementById('search-input') as HTMLInputElement | null;
	const status = document.getElementById('search-status');
	const list = document.getElementById('search-results');

	if (modal && input && status && list) {
		const strings = modal.dataset;
		let results: SearchResult[] = [];
		let activeIndex = -1;
		let debounceTimer: number | undefined;
		let inFlight: AbortController | undefined;
		let reportTimer: number | undefined;
		let lastReportedQuery = '';

		const reportSearchUsed = (query: string, resultsCount: number) => {
			if (query === lastReportedQuery) return;
			lastReportedQuery = query;
			document.dispatchEvent(
				new CustomEvent('blog:telemetry', { detail: { type: 'search_used', resultsCount } }),
			);
		};

		const setStatus = (message: string) => {
			status.textContent = message;
			status.hidden = message === '';
		};

		const optionId = (index: number) => `search-option-${index}`;

		const setActive = (index: number) => {
			const options = list.querySelectorAll<HTMLAnchorElement>('a[role="option"]');
			activeIndex = options.length === 0 ? -1 : (index + options.length) % options.length;
			options.forEach((option, optionIndex) => {
				const isActive = optionIndex === activeIndex;
				option.classList.toggle(ACTIVE_CLASS, isActive);
				option.setAttribute('aria-selected', String(isActive));
				if (isActive) option.scrollIntoView({ block: 'nearest' });
			});
			if (activeIndex >= 0) input.setAttribute('aria-activedescendant', optionId(activeIndex));
			else input.removeAttribute('aria-activedescendant');
		};

		const formatDate = (iso: string) => {
			const date = new Date(iso);
			return Number.isNaN(date.getTime())
				? ''
				: date.toLocaleDateString(strings.dateLocale, {
						year: 'numeric',
						month: 'short',
						day: 'numeric',
					});
		};

		const renderResults = () => {
			list.replaceChildren(
				...results.map((result, index) => {
					const item = document.createElement('li');
					const link = document.createElement('a');
					link.href = previewAwareHref(result.url);
					link.id = optionId(index);
					link.setAttribute('role', 'option');
					link.setAttribute('aria-selected', 'false');
					link.className = 'flex flex-col items-start gap-1 py-3';
					const title = document.createElement('span');
					title.className = 'font-semibold';
					title.textContent = result.title;
					const meta = document.createElement('span');
					meta.className = 'text-xs text-base-content/60';
					meta.textContent = formatDate(result.publishedAt);
					const description = document.createElement('span');
					description.className = 'text-sm text-base-content/70 line-clamp-2';
					description.textContent = result.description;
					link.replaceChildren(title, meta, description);
					link.addEventListener('mousemove', () => setActive(index));
					item.replaceChildren(link);
					return item;
				}),
			);
			input.setAttribute('aria-expanded', String(results.length > 0));
			setActive(results.length > 0 ? 0 : -1);
		};

		const search = async (query: string) => {
			window.clearTimeout(reportTimer);
			inFlight?.abort();
			const controller = new AbortController();
			inFlight = controller;
			setStatus(strings.loading ?? '');
			try {
				const url = new URL(strings.endpoint ?? '', window.location.origin);
				url.searchParams.set('q', query);
				url.searchParams.set('locale', strings.locale ?? 'en');
				const response = await fetch(url, { signal: controller.signal });
				if (!response.ok) throw new Error(`Search failed with ${response.status}`);
				const payload = (await response.json()) as { results: SearchResult[] };
				results = payload.results;
				renderResults();
				setStatus(results.length === 0 ? (strings.empty ?? '').replaceAll('{query}', query) : '');
				const resultsCount = results.length;
				reportTimer = window.setTimeout(
					() => reportSearchUsed(query, resultsCount),
					RESULTS_REPORT_DELAY_MS,
				);
			} catch (error) {
				if (controller.signal.aborted) return;
				results = [];
				renderResults();
				setStatus(strings.error ?? '');
				console.error(error);
			}
		};

		const onInput = () => {
			window.clearTimeout(debounceTimer);
			const query = input.value.trim().slice(0, MAX_QUERY_LENGTH);
			if (query.length < MIN_QUERY_LENGTH) {
				window.clearTimeout(reportTimer);
				lastReportedQuery = '';
				inFlight?.abort();
				results = [];
				renderResults();
				setStatus(strings.hint ?? '');
				return;
			}
			debounceTimer = window.setTimeout(() => search(query), DEBOUNCE_MS);
		};

		const onKeydown = (event: KeyboardEvent) => {
			if (event.key === 'ArrowDown') {
				event.preventDefault();
				setActive(activeIndex + 1);
			} else if (event.key === 'ArrowUp') {
				event.preventDefault();
				setActive(activeIndex - 1);
			} else if (event.key === 'Enter' && activeIndex >= 0) {
				event.preventDefault();
				const href = results[activeIndex]?.url;
				if (href) window.location.assign(previewAwareHref(href));
			}
		};

		const openSearch = () => {
			if (!modal.open) modal.showModal();
			input.focus();
			input.select();
		};

		input.addEventListener('input', onInput);
		input.addEventListener('keydown', onKeydown);

		document.querySelectorAll('[data-search-open]').forEach((trigger) => {
			trigger.addEventListener('click', openSearch);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== '/' || modal.open) return;
			const target = event.target as HTMLElement;
			const tag = target.tagName;
			if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || target.isContentEditable) {
				return;
			}
			event.preventDefault();
			openSearch();
		});
	}
</script>
