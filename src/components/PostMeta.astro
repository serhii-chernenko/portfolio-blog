---
import type { AnyPost } from '../lib/posts';
import type { Locale } from '../i18n/config';
import { readingTimeMinutes } from '../lib/reading-time';
import { useTranslations } from '../i18n/utils';

export interface Props {
  post: AnyPost;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = useTranslations(locale);
const minutes = readingTimeMinutes(typeof post.body === 'string' ? post.body : '');

const publishedFormatted = post.data.publishedAt.toLocaleDateString(
  locale === 'uk' ? 'uk-UA' : 'en-US',
  { year: 'numeric', month: 'long', day: 'numeric' }
);

const updatedFormatted = post.data.updatedAt?.toLocaleDateString(
  locale === 'uk' ? 'uk-UA' : 'en-US',
  { year: 'numeric', month: 'long', day: 'numeric' }
);
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-base-content/60">
  <time
    datetime={post.data.publishedAt.toISOString()}
    title={t('post.publishedOn', { date: publishedFormatted })}
  >
    {t('post.publishedOn', { date: publishedFormatted })}
  </time>

  {updatedFormatted && post.data.updatedAt && (
    <>
      <span aria-hidden="true">·</span>
      <time
        datetime={post.data.updatedAt.toISOString()}
        title={t('post.updatedOn', { date: updatedFormatted })}
      >
        {t('post.updatedOn', { date: updatedFormatted })}
      </time>
    </>
  )}

  <span aria-hidden="true">·</span>
  <span>{t('post.readingTime', { minutes })}</span>
</div>
