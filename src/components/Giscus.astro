---
import type { Locale } from '../i18n/config';
import { htmlLangAttribute } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import {
  PUBLIC_GISCUS_REPO,
  PUBLIC_GISCUS_REPO_ID,
  PUBLIC_GISCUS_CATEGORY,
  PUBLIC_GISCUS_CATEGORY_ID,
} from 'astro:env/client';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const repo = PUBLIC_GISCUS_REPO;
const repoId = PUBLIC_GISCUS_REPO_ID;
const category = PUBLIC_GISCUS_CATEGORY;
const categoryId = PUBLIC_GISCUS_CATEGORY_ID;

// Render nothing if not configured
const isConfigured = repo && repoId && category && categoryId;
---

{isConfigured && (
  <section class="mt-12 pt-8 border-t border-base-300" aria-label={t('comments.title')}>
    <h2 class="text-xl font-semibold mb-6">{t('comments.title')}</h2>

    <div id="giscus-container" data-locale={locale}></div>

    <script
      is:inline
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-lang={htmlLangAttribute[locale]}
    >
      (function () {
        var script = document.createElement('script');
        var container = document.getElementById('giscus-container');
        var el = document.querySelector('[data-repo]');
        if (!el || !container) return;

        // Read data attrs from the inline script tag
        var scripts = document.querySelectorAll('script[data-repo]');
        var cfg = scripts[scripts.length - 1];

        script.src = 'https://giscus.app/client.js';
        script.setAttribute('data-repo', cfg.getAttribute('data-repo') || '');
        script.setAttribute('data-repo-id', cfg.getAttribute('data-repo-id') || '');
        script.setAttribute('data-category', cfg.getAttribute('data-category') || '');
        script.setAttribute('data-category-id', cfg.getAttribute('data-category-id') || '');
        script.setAttribute('data-mapping', 'pathname');
        script.setAttribute('data-strict', '0');
        script.setAttribute('data-reactions-enabled', '1');
        script.setAttribute('data-emit-metadata', '0');
        script.setAttribute('data-input-position', 'bottom');
        script.setAttribute('data-theme', document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
        script.setAttribute('data-lang', cfg.getAttribute('data-lang') || 'en');
        script.setAttribute('data-loading', 'lazy');
        script.crossOrigin = 'anonymous';
        script.async = true;

        container.appendChild(script);
      })();
    </script>
  </section>
)}
