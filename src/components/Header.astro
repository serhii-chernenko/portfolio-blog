---
import type { Locale } from '../i18n/config';
import { useTranslations, localeHref } from '../i18n/utils';
import type { LayoutData, NavLink } from '../lib/site';
import { mediaUrl } from '../lib/cms/media';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

export interface Props {
	locale: Locale;
	currentPath?: string;
	translatedUrls?: Partial<Record<Locale, string | null>>;
	layout: LayoutData;
}

const { locale, currentPath, translatedUrls, layout } = Astro.props;
const t = useTranslations(locale, Astro.locals.uiOverrides);

const navLinks = layout.header;
const siteName = layout.settings.siteName;
// Settings → General: Logo replaces the text site name when set.
const logo = layout.site.logo;
const logoSrc = logo ? mediaUrl(logo) : '';
const currentPathname = currentPath ?? Astro.url.pathname;

function isActive(link: NavLink): boolean {
	return !link.isExternal && currentPathname.startsWith(link.href);
}

function linkTarget(link: NavLink) {
	return link.openInNewTab
		? { target: '_blank', rel: link.isExternal ? 'noopener noreferrer' : undefined }
		: {};
}
---

<!-- Skip-to-content -->
<a
	href="#content"
	class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 btn btn-primary btn-sm"
>
	{t('nav.skip')}
</a>

<!-- Mobile drawer. The sticky positioning lives on this wrapper, not on
     <header>: the header's own parent (.drawer-content) is only as tall as
     the header, so a sticky header would have no room to stick. As a direct
     child of <body> the wrapper sticks for the whole page. -->
<div class="drawer sticky top-0 z-40">
	<input id="nav-drawer" type="checkbox" class="drawer-toggle" aria-hidden="true" />

	<div class="drawer-content flex flex-col">
		<!-- Navbar -->
		<header class="navbar bg-base-100/90 backdrop-blur-2xl px-4">
			<!-- Left: hamburger (mobile) + logo -->
			<div class="navbar-start gap-2">
				<label
					for="nav-drawer"
					class="btn btn-ghost btn-square lg:hidden"
					aria-label={t('nav.menu')}
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="size-6"
						aria-hidden="true"
					>
						<line x1="4" x2="20" y1="6" y2="6"></line>
						<line x1="4" x2="20" y1="12" y2="12"></line>
						<line x1="4" x2="20" y1="18" y2="18"></line>
					</svg>
				</label>

				<a href={localeHref(locale)} class="btn btn-ghost text-xl font-bold">
					{logoSrc ? (
						<img src={logoSrc} alt={siteName} class="h-8 w-auto" decoding="async" />
					) : (
						siteName
					)}
				</a>
			</div>

			<!-- Center: desktop nav links -->
			<nav class="navbar-center hidden lg:flex" aria-label="Main navigation">
				<ul class="menu menu-horizontal gap-1 p-0">
					{navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class={isActive(link) ? 'active font-medium' : 'font-medium'}
								aria-current={isActive(link) ? 'page' : undefined}
								{...linkTarget(link)}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<!-- Right: search, theme, language -->
			<div class="navbar-end gap-1">
				<button
					class="btn btn-ghost btn-square"
					data-search-open
					aria-label={t('nav.search')}
					title={t('nav.search')}
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="size-5"
						aria-hidden="true"
					>
						<circle cx="11" cy="11" r="8"></circle>
						<path d="m21 21-4.35-4.35"></path>
					</svg>
				</button>

				<kbd class="kbd kbd-sm hidden lg:inline-flex"> / </kbd>

				<ThemeToggle locale={locale} />

				<LanguageSwitcher
					locale={locale}
					currentPath={currentPathname}
					translatedUrls={translatedUrls}
				/>
			</div>
		</header>
	</div>

	<!-- Mobile drawer sidebar -->
	<div class="drawer-side z-50">
		<label for="nav-drawer" aria-label="Close menu" class="drawer-overlay"></label>
		<nav
			class="min-h-full w-72 bg-base-100 border-r border-base-300 p-4"
			aria-label="Mobile navigation"
		>
			<a href={localeHref(locale)} class="text-xl font-bold block mb-6">
				{logoSrc ? (
					<img src={logoSrc} alt={siteName} class="h-8 w-auto" decoding="async" />
				) : (
					siteName
				)}
			</a>
			<ul class="menu w-full">
				{navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							class={isActive(link) ? 'active' : ''}
							aria-current={isActive(link) ? 'page' : undefined}
							{...linkTarget(link)}
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</div>
