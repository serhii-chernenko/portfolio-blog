---
import type { TypedObjectProps } from 'astro-portabletext/types';
import { highlightCode } from '../../lib/highlighter';

type Props = TypedObjectProps;

interface CodeNode {
	code?: string;
	language?: string;
	filename?: string;
}

const { node } = Astro.props;
const { code = '', language, filename: rawFilename } = node as unknown as CodeNode;
const filename = rawFilename ? rawFilename.trim() : '';
const html = highlightCode(code, language ? language : undefined);
---

{filename && <div class="code-filename">{filename}</div>}
<Fragment set:html={html} />
