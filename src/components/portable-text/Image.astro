---
import type { TypedObjectProps } from 'astro-portabletext/types';
import { imageDimensions, isMediaImage, mediaUrl, type MediaImage } from '../../lib/cms/media';

type Props = TypedObjectProps;

/** An EmDash Portable Text image block: the media reference plus per-use alt, caption and size. */
interface ImageNode {
	asset?: MediaImage & { _ref?: string };
	alt?: string;
	caption?: string;
	width?: number;
	height?: number;
}

const DEFAULT_WIDTH = 1024;

const { node } = Astro.props;
const image = node as unknown as ImageNode;
const asset = image.asset;
const src = isMediaImage(asset) ? mediaUrl(asset) : '';
const original = imageDimensions({
	width: image.width ?? asset?.width,
	height: image.height ?? asset?.height,
});
const width = original ? Math.min(DEFAULT_WIDTH, original.width) : DEFAULT_WIDTH;
const height = original ? Math.round((width * original.height) / original.width) : undefined;
const alt = image.alt ?? asset?.alt ?? '';
const caption = image.caption?.trim();
---

{src && (
	<figure>
		<img
			src={src}
			alt={alt}
			width={width}
			height={height}
			loading="lazy"
			decoding="async"
			class="rounded-box"
		/>
		{caption && <figcaption>{caption}</figcaption>}
	</figure>
)}
