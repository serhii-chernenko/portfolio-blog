---
import type { TypedObject, TypedObjectProps } from 'astro-portabletext/types';
import { youtubeVideoId } from '../../lib/portable-text';

type Props = TypedObjectProps;

interface YouTubeNode extends TypedObject {
	id?: string;
	videoId?: string;
	title?: string;
}

const VIDEO_ID_PATTERN = /^[A-Za-z0-9_-]{6,20}$/;
const DEFAULT_TITLE = 'YouTube video';

const { node } = Astro.props;
const youtube = node as unknown as YouTubeNode;
const id = youtubeVideoId(youtube);
const title = youtube.title?.trim() || DEFAULT_TITLE;
const src = `https://www.youtube-nocookie.com/embed/${id}`;
---

{VIDEO_ID_PATTERN.test(id) && (
	<div class="not-prose my-8">
		<div class="card bg-base-200 border border-base-300 overflow-hidden">
			<div class="relative w-full" style="padding-bottom: 56.25%;">
				<iframe
					src={src}
					title={title}
					class="absolute inset-0 w-full h-full"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
					loading="lazy"
					referrerpolicy="strict-origin-when-cross-origin"
				/>
			</div>
			{title !== DEFAULT_TITLE && (
				<div class="card-body py-2 px-4">
					<p class="text-sm text-base-content/60">{title}</p>
				</div>
			)}
		</div>
	</div>
)}
