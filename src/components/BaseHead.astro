---
import { PUBLIC_GOOGLE_SITE_VERIFICATION, PUBLIC_BING_SITE_VERIFICATION } from 'astro:env/client';
import { stegaClean } from '@sanity/client/stega';
import { locales, type Locale } from '../i18n/config';
import {
	buildCanonical,
	buildHreflang,
	blogPostingJsonLd,
	blogJsonLd,
	breadcrumbJsonLd,
	websiteJsonLd,
	ogLocaleFor,
	serializeJsonLd,
} from '../lib/seo';
import { defaultOgImage, DEFAULT_OG_IMAGE_WIDTH, DEFAULT_OG_IMAGE_HEIGHT } from '../lib/og';
import { imageUrl } from '../lib/sanity/image';
import type { LayoutData } from '../lib/site';
import type { PageType } from '../lib/telemetry-schema';
import { useTranslations, localeHref, withBase } from '../i18n/utils';

export interface Props {
	title: string;
	description: string;
	locale: Locale;
	image?: string;
	imageWidth?: number;
	imageHeight?: number;
	imageAlt?: string;
	type?: 'website' | 'article';
	publishedAt?: Date;
	updatedAt?: Date;
	tags?: string[];
	alternates?: Partial<Record<Locale, string | null>>;
	noIndex?: boolean;
	noIndexFollow?: boolean;
	omitCanonical?: boolean;
	pageType?: PageType;
	layout: LayoutData;
}

const {
	title: rawTitle,
	description: rawDescription,
	locale,
	image,
	imageWidth,
	imageHeight,
	imageAlt: rawImageAlt,
	type = 'website',
	publishedAt,
	updatedAt,
	tags: rawTags,
	alternates: rawAlternates,
	noIndex = false,
	noIndexFollow = false,
	omitCanonical = false,
	pageType,
	layout,
} = Astro.props;

const t = useTranslations(locale, Astro.locals.uiOverrides);
const title = stegaClean(rawTitle);
const description = stegaClean(rawDescription);
const tags = rawTags?.map((tag) => stegaClean(tag));
const alternates = rawAlternates ? stegaClean(rawAlternates) : undefined;
const site = Astro.site!;
const canonical = buildCanonical(site, Astro.url.pathname);
const hreflangLinks = buildHreflang(site, locale, Astro.url.pathname, alternates);
const siteName = stegaClean(layout.settings.siteName);
const settingsOgImage = layout.settings.defaultOgImage
	? imageUrl(layout.settings.defaultOgImage, {
			width: DEFAULT_OG_IMAGE_WIDTH,
			height: DEFAULT_OG_IMAGE_HEIGHT,
			format: 'jpg',
		})
	: undefined;
const ogImage = image ?? settingsOgImage ?? defaultOgImage(site);
const ogImageWidth = image ? imageWidth : DEFAULT_OG_IMAGE_WIDTH;
const ogImageHeight = image ? imageHeight : DEFAULT_OG_IMAGE_HEIGHT;
const ogImageAlt =
	(rawImageAlt ? stegaClean(rawImageAlt) : undefined) ?? (image ? title : siteName);
const robotsContent = noIndex
	? 'noindex,nofollow,noarchive'
	: noIndexFollow
		? 'noindex,follow'
		: undefined;
const alternateOgLocales = locales
	.filter((alternateLocale) => alternateLocale !== locale && alternates?.[alternateLocale])
	.map((alternateLocale) => ogLocaleFor(alternateLocale));
const authorPath = layout.aboutPath;
const authorCanonical = buildCanonical(site, authorPath);
const isArticle = type === 'article' && publishedAt !== undefined;
const modifiedAt = updatedAt ?? publishedAt;
const homePath = localeHref(locale);

const jsonLdBlocks: object[] = [];
if (isArticle) {
	jsonLdBlocks.push(
		blogPostingJsonLd({
			site,
			pathname: Astro.url.pathname,
			locale,
			title,
			description,
			image: ogImage,
			publishedAt,
			updatedAt,
			tags,
			authorPath,
		}),
		breadcrumbJsonLd({
			site,
			crumbs: [
				{ name: siteName, path: homePath },
				{ name: stegaClean(t('nav.posts')), path: localeHref(locale, 'posts/') },
				{ name: title, path: Astro.url.pathname },
			],
		}),
	);
} else if (pageType === 'home') {
	const websiteInput = { site, homePath, siteName, description, locale, authorPath };
	jsonLdBlocks.push(websiteJsonLd(websiteInput), blogJsonLd(websiteInput));
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>
<meta name="description" content={description} />
{robotsContent && <meta name="robots" content={robotsContent} />}
{tags && tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
{PUBLIC_GOOGLE_SITE_VERIFICATION && (
	<meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />
)}
{PUBLIC_BING_SITE_VERIFICATION && (
	<meta name="msvalidate.01" content={PUBLIC_BING_SITE_VERIFICATION} />
)}

{!omitCanonical && <link rel="canonical" href={canonical} />}

<link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
<link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
<link rel="manifest" href={withBase('site.webmanifest')} />

{hreflangLinks.map(({ hreflang, href }) => (
	<link rel="alternate" hreflang={hreflang} href={href} />
))}

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocaleFor(locale)} />
{alternateOgLocales.map((alternateOgLocale) => (
	<meta property="og:locale:alternate" content={alternateOgLocale} />
))}
{isArticle && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{isArticle && modifiedAt && (
	<meta property="article:modified_time" content={modifiedAt.toISOString()} />
)}
{isArticle && <meta property="article:author" content={authorCanonical} />}
{isArticle && tags && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{jsonLdBlocks.map((block) => (
	<script is:inline type="application/ld+json" set:html={serializeJsonLd(block)} />
))}

<link
	rel="alternate"
	type="application/rss+xml"
	title={`${siteName} — RSS`}
	href={new URL(localeHref(locale, 'rss.xml'), site).toString()}
/>

<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1d232a" media="(prefers-color-scheme: dark)" />

<script is:inline>
	(function () {
		try {
			var stored = localStorage.getItem('theme');
			var theme =
				stored === 'light' || stored === 'dark'
					? stored
					: window.matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light';
			document.documentElement.setAttribute('data-theme', theme);
		} catch (e) {}
	})();
</script>
