---
import { stegaClean } from '@sanity/client/stega';
import type { Locale } from '../i18n/config';
import {
	buildCanonical,
	buildHreflang,
	articleJsonLd,
	websiteJsonLd,
	ogLocaleFor,
	serializeJsonLd,
} from '../lib/seo';
import { defaultOgImage } from '../lib/og';
import { imageUrl } from '../lib/sanity/image';
import type { LayoutData } from '../lib/site';
import { withBase } from '../i18n/utils';

export interface Props {
	title: string;
	description: string;
	locale: Locale;
	image?: string;
	type?: 'website' | 'article';
	publishedAt?: Date;
	updatedAt?: Date;
	tags?: string[];
	alternates?: Partial<Record<Locale, string | null>>;
	noIndex?: boolean;
	layout: LayoutData;
}

const OG_IMAGE_WIDTH = 1200;
const OG_IMAGE_HEIGHT = 630;

const {
	title: rawTitle,
	description: rawDescription,
	locale,
	image,
	type = 'website',
	publishedAt,
	updatedAt,
	tags: rawTags,
	alternates: rawAlternates,
	noIndex = false,
	layout,
} = Astro.props;

const title = stegaClean(rawTitle);
const description = stegaClean(rawDescription);
const tags = rawTags?.map((tag) => stegaClean(tag));
const alternates = rawAlternates ? stegaClean(rawAlternates) : undefined;
const site = Astro.site!;
const canonical = buildCanonical(site, Astro.url.pathname);
const hreflangLinks = buildHreflang(site, locale, Astro.url.pathname, alternates);
const settingsOgImage = layout.settings.defaultOgImage
	? imageUrl(layout.settings.defaultOgImage, {
			width: OG_IMAGE_WIDTH,
			height: OG_IMAGE_HEIGHT,
			format: 'jpg',
		})
	: undefined;
const ogImage = image ?? settingsOgImage ?? defaultOgImage(site);
const siteName = stegaClean(layout.settings.siteName);

const jsonLd =
	type === 'article' && publishedAt
		? articleJsonLd({
				site,
				pathname: Astro.url.pathname,
				locale,
				title,
				description,
				image: ogImage,
				publishedAt,
				updatedAt,
				authorName: 'Serhii Chernenko',
				authorUrl: layout.aboutPath,
			})
		: websiteJsonLd({
				site,
				siteName,
				description,
				locale,
			});
---

<!-- Character encoding & viewport -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Primary meta -->
<title>{title}</title>
<meta name="description" content={description} />
{noIndex && <meta name="robots" content="noindex,nofollow,noarchive" />}
{tags && tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}

<!-- Canonical -->
<link rel="canonical" href={canonical} />

<!-- Hreflang alternates -->
{
	hreflangLinks.map(({ hreflang, href }) => (
		<link rel="alternate" hreflang={hreflang} href={href} />
	))
}

<!-- OpenGraph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocaleFor(locale)} />
{
	type === 'article' && publishedAt && (
		<meta property="article:published_time" content={publishedAt.toISOString()} />
	)
}
{
	type === 'article' && updatedAt && (
		<meta property="article:modified_time" content={updatedAt.toISOString()} />
	)
}
{type === 'article' && tags && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- JSON-LD -->
<script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />

<!-- RSS auto-discovery -->
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${siteName} — RSS`}
	href={new URL(withBase(`${locale}/rss.xml`), site).toString()}
/>

<!-- Theme color -->
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1d232a" media="(prefers-color-scheme: dark)" />

<!-- Pre-paint theme script: runs before body to avoid FOUC -->
<script is:inline>
	(function () {
		try {
			var stored = localStorage.getItem('theme');
			var theme =
				stored === 'light' || stored === 'dark'
					? stored
					: window.matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light';
			document.documentElement.setAttribute('data-theme', theme);
		} catch (e) {}
	})();
</script>
