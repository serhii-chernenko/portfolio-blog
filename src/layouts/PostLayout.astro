---
import type { Locale } from '../i18n/config';
import type { AnyPost } from '../lib/posts';
import { localeOf, tagSlug } from '../lib/posts';
import { getTranslatedPostUrls, useTranslations, localeHref } from '../i18n/utils';
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Giscus from '../components/Giscus.astro';

export interface Props {
  post: AnyPost;
  locale: Locale;
  headings: { depth: number; slug: string; text: string }[];
  translationKey?: string;
  alternates?: Partial<Record<Locale, string | null>>;
  readingTime?: number;
}

const { post, locale, headings, translationKey, alternates } = Astro.props;
const t = useTranslations(locale);

// Resolve translated URLs for language switcher
let translatedUrls: Partial<Record<Locale, string | null>> | undefined;
if (translationKey) {
  translatedUrls = await getTranslatedPostUrls(translationKey);
}

const isDraft = post.data.draft;
const showDraft = isDraft && (import.meta.env.DEV || import.meta.env.PREVIEW_MODE === 'true');

// Tags with computed slugs
const tags = post.data.tags ?? [];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  locale={locale}
  image={post.data.heroImage ? undefined : undefined}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={tags}
  alternates={alternates ?? translatedUrls}
  translatedUrls={translatedUrls}
>
  <!-- Article header: bg-base-200 section with back button, title, meta, hero image -->
  <section class="bg-base-200">
    <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 flex flex-col gap-8 py-8 sm:py-10 lg:py-14">
      <!-- Back button -->
      <a
        href={localeHref(locale, 'posts/')}
        class="group/cta inline-flex items-center gap-1.5 btn btn-ghost btn-xs self-start"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cta-icon-left" aria-hidden="true">
          <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>
        </svg>
        {t('nav.posts')}
      </a>

      <div class="max-w-4xl space-y-6">
        <!-- Draft badge -->
        {showDraft && (
          <span class="badge badge-warning">{t('post.draft')}</span>
        )}

        <div class="space-y-4">
          <h1 class="max-w-5xl font-black tracking-tight text-balance text-4xl sm:text-5xl lg:text-6xl">
            {post.data.title}
          </h1>
          {post.data.description && (
            <p class="max-w-3xl text-lg sm:text-xl leading-8 text-base-content/70">
              {post.data.description}
            </p>
          )}
        </div>

        <!-- Meta badges -->
        <div class="flex flex-wrap gap-2">
          <time
            datetime={post.data.publishedAt.toISOString()}
            class="badge badge-primary badge-outline badge-sm rounded-full"
          >
            {post.data.publishedAt.toLocaleDateString(locale === 'uk' ? 'uk-UA' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {tags.map((tag) => (
            <a
              href={localeHref(locale, `tags/${tagSlug(tag)}`)}
              class="badge badge-primary badge-outline badge-sm rounded-full hover:badge-primary hover:text-primary-content transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
      </div>

      <!-- Hero image -->
      {post.data.heroImage && (
        <div class="overflow-hidden rounded-box bg-base-300 shadow-sm">
          <div class="relative aspect-video w-full">
            <img
              src={typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage.src}
              alt={post.data.heroImageAlt ?? post.data.title}
              width={1200}
              height={675}
              class="w-full h-full object-cover object-center"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Article body + sidebar -->
  <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12 lg:py-16">
    <div class="lg:grid lg:grid-cols-[1fr_240px] lg:gap-12">
      <!-- Main prose content -->
      <div class="min-w-0">
        <!-- Article body — Pagefind indexes this -->
        <article
          class="prose dark:prose-invert lg:prose-lg max-w-none"
          data-pagefind-body
          data-pagefind-meta={`locale:${locale}`}
          lang={locale === 'uk' ? 'uk-UA' : 'en'}
        >
          <slot />
        </article>

        <!-- Tags at bottom -->
        {tags.length > 0 && (
          <div class="mt-10 pt-8 border-t border-base-300">
            <p class="text-sm font-medium text-base-content/60 mb-3">{t('post.tags')}</p>
            <div class="flex flex-wrap gap-2" aria-label={t('post.tags')}>
              {tags.map((tag) => (
                <a
                  href={localeHref(locale, `tags/${tagSlug(tag)}`)}
                  class="badge badge-outline hover:badge-primary transition-colors"
                >
                  {tag}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Comments -->
        <Giscus locale={locale} />
      </div>

      <script>
        function enhanceCodeBlocks() {
          const blocks = document.querySelectorAll<HTMLPreElement>(
            'article .astro-code:not([data-enhanced])',
          );
          blocks.forEach((pre) => {
            pre.setAttribute('data-enhanced', '1');
            const lang = pre.getAttribute('data-language') || '';

            const wrap = document.createElement('div');
            wrap.className = 'code-block-wrap mockup-code w-full';
            pre.parentNode?.insertBefore(wrap, pre);
            wrap.appendChild(pre);

            if (lang) {
              const badge = document.createElement('span');
              badge.className = 'lang-badge';
              badge.textContent = lang;
              wrap.appendChild(badge);
            }

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'copy-btn btn btn-ghost btn-xs';
            btn.setAttribute('aria-label', 'Copy code');
            btn.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true">
                <path d="M7 3.5A1.5 1.5 0 0 1 8.5 2h3.879a1.5 1.5 0 0 1 1.06.44l3.122 3.12A1.5 1.5 0 0 1 17 6.622V12.5a1.5 1.5 0 0 1-1.5 1.5h-1v-3.379a3 3 0 0 0-.879-2.121L10.5 5.379A3 3 0 0 0 8.379 4.5H7v-1Z" />
                <path d="M4.5 6A1.5 1.5 0 0 0 3 7.5v9A1.5 1.5 0 0 0 4.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L9.44 6.439A1.5 1.5 0 0 0 8.378 6H4.5Z" />
              </svg>`;
            btn.addEventListener('click', async () => {
              const code = pre.querySelector('code');
              const text = code?.textContent ?? '';
              try {
                await navigator.clipboard.writeText(text);
              } catch {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
              }
              btn.setAttribute('aria-label', 'Copied!');
              setTimeout(() => btn.setAttribute('aria-label', 'Copy code'), 1500);
            });
            wrap.appendChild(btn);
          });
        }

        enhanceCodeBlocks();
        document.addEventListener('astro:after-swap', enhanceCodeBlocks);
      </script>

      <!-- Sidebar: Table of Contents (lg+) -->
      <aside class="hidden lg:block" aria-label={t('post.toc')}>
        <TableOfContents headings={headings} locale={locale} />
      </aside>
    </div>
  </div>
</BaseLayout>
