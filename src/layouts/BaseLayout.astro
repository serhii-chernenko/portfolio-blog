---
import type { Locale } from '../i18n/config';
import { htmlLangAttribute } from '../i18n/config';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
	locale: Locale;
	image?: string;
	type?: 'website' | 'article';
	publishedAt?: Date;
	updatedAt?: Date;
	tags?: string[];
	alternates?: Partial<Record<Locale, string | null>>;
	translationKey?: string;
	/** Pre-resolved translated post URLs for LanguageSwitcher on post pages */
	translatedUrls?: Partial<Record<Locale, string | null>>;
	/** Pre-resolved author page URL for JSON-LD on article pages */
	authorUrl?: string;
}

const {
	title,
	description,
	locale,
	image,
	type,
	publishedAt,
	updatedAt,
	tags,
	alternates,
	translatedUrls,
	authorUrl,
} = Astro.props;

const lang = htmlLangAttribute[locale];
---

<!doctype html>
<html lang={lang} data-theme="light">
	<head>
		<BaseHead
			title={title}
			description={description}
			locale={locale}
			image={image}
			type={type}
			publishedAt={publishedAt}
			updatedAt={updatedAt}
			tags={tags}
			alternates={alternates}
			authorUrl={authorUrl}
		/>
	</head>
	<body class="min-h-screen flex flex-col bg-base-100 text-base-content">
		<Header locale={locale} currentPath={Astro.url.pathname} translatedUrls={translatedUrls} />

		<main id="content" class="flex-1">
			<slot />
		</main>

		<Footer locale={locale} currentPath={Astro.url.pathname} translatedUrls={translatedUrls} />

		<SearchModal locale={locale} />
	</body>
</html>
