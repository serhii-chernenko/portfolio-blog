---
import type { Locale } from '../i18n/config';
import { htmlLangAttribute } from '../i18n/config';
import { getSanityContext } from '../lib/sanity/request';
import { getLayoutData } from '../lib/site';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import PreviewTools from '../components/PreviewTools.astro';
import { PREVIEW_ROOT_ATTRIBUTE } from '../lib/preview-links';
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
	locale: Locale;
	image?: string;
	type?: 'website' | 'article';
	publishedAt?: Date;
	updatedAt?: Date;
	tags?: string[];
	alternates?: Partial<Record<Locale, string | null>>;
	/** Pre-resolved translated URLs for the LanguageSwitcher on post and page routes */
	translatedUrls?: Partial<Record<Locale, string | null>>;
	/** Prevent sensitive or utility pages from appearing in search results. */
	noIndex?: boolean;
}

const {
	title,
	description,
	locale,
	image,
	type,
	publishedAt,
	updatedAt,
	tags,
	alternates,
	translatedUrls,
	noIndex = false,
} = Astro.props;

const lang = htmlLangAttribute[locale];
const sanity = getSanityContext(Astro.locals);
const layout = await getLayoutData(locale, sanity);
const previewRootAttributes = sanity.preview ? { [PREVIEW_ROOT_ATTRIBUTE]: '' } : {};
---

<!doctype html>
<html lang={lang} data-theme="light" {...previewRootAttributes}>
	<head>
		<BaseHead
			title={title}
			description={description}
			locale={locale}
			image={image}
			type={type}
			publishedAt={publishedAt}
			updatedAt={updatedAt}
			tags={tags}
			alternates={alternates}
			noIndex={noIndex || sanity.preview}
			layout={layout}
		/>
	</head>
	<body class="min-h-screen flex flex-col bg-base-100 text-base-content">
		<Header
			locale={locale}
			currentPath={Astro.url.pathname}
			translatedUrls={translatedUrls}
			layout={layout}
		/>

		<main id="content" class="flex-1">
			<slot />
		</main>

		<Footer
			locale={locale}
			currentPath={Astro.url.pathname}
			translatedUrls={translatedUrls}
			layout={layout}
		/>

		<SearchModal locale={locale} />

		{sanity.preview && <PreviewTools locale={locale} />}
	</body>
</html>
