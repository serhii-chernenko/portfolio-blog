# =============================================================================
# Environment template. Copy to `.env` (gitignored) for `pnpm dev`.
# `pnpm wrangler:dev` reads from `.dev.vars` instead — see .dev.vars.example.
# Production secrets live in Cloudflare via `wrangler secret put`.
# =============================================================================

# ── Public (safe to expose; inlined into client/server bundles) ──────────────
SITE_URL=https://serhiichernenko.com
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=your-keystatic-github-app-slug
PUBLIC_GISCUS_REPO=serhii-chernenko/portfolio-blog
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_CF_ANALYTICS_TOKEN=

# ── Email (Cloudflare Email Service) ─────────────────────────────────────────
# SEND_EMAIL is a Worker binding, not an env var — configured in wrangler.jsonc.
# MAIL_FROM must be on a domain with Cloudflare Email Routing enabled.
MAIL_FROM=hello@blog.chernenko.digital

# ── Required secrets (dev placeholders; production via `wrangler secret put`) ─
SUBSCRIBE_RATE_LIMIT_SECRET=replace-me-with-32-bytes-random
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Keystatic GitHub mode (PRODUCTION ONLY) ──────────────────────────────────
# Local dev and `wrangler:dev` use Keystatic local kind — these are unused there.
# In production (deployed Worker) Keystatic switches to GitHub mode and requires:
#   - KEYSTATIC_SECRET                 32-byte random; signs admin auth cookies
#   - KEYSTATIC_GITHUB_CLIENT_ID       GitHub App client ID
#   - KEYSTATIC_GITHUB_CLIENT_SECRET   GitHub App client secret
# Set them via `wrangler secret put`. See docs/KEYSTATIC.md.
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# ── Preview deploys only ─────────────────────────────────────────────────────
PREVIEW_MODE=true
