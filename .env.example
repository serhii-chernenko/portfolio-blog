# --- Public (safe to expose) ---
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=your-keystatic-github-app-slug
PUBLIC_GISCUS_REPO=inevix/portfolio-blog
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_CF_ANALYTICS_TOKEN=

# --- Site ---
SITE_URL=https://blog.chernenko.digital

# --- Email (Cloudflare Email Service) ---
# SEND_EMAIL is a Cloudflare Worker binding — NOT an env var.
# Configure it in wrangler.jsonc under "send_email". No key/token needed here.
# MAIL_FROM is a var (set in wrangler.jsonc "vars" or via `wrangler secret put MAIL_FROM`).
# It must be an address on a domain with CF Email Routing enabled.
MAIL_FROM=hello@blog.chernenko.digital

# --- Local development only (in production these are wrangler secrets) ---
TELEGRAM_BOT_TOKEN=xxxxx
TELEGRAM_CHAT_ID=xxxxx
SUBSCRIBE_RATE_LIMIT_SECRET=replace-me-with-32-bytes-random
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=replace-me-with-32-bytes-random

# --- Preview deploys only ---
PREVIEW_MODE=true
