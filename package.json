{
  "name": "portfolio-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "PUBLIC_KEYSTATIC_MODE=local astro dev",
    "build": "astro build && pagefind --site dist/blog --output-path dist/blog/pagefind && node ./scripts/post-build.mjs",
    "build:astro": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "wrangler:dev": "pnpm build && wrangler dev",
    "wrangler:deploy": "pnpm build && wrangler deploy",
    "d1:apply:local": "wrangler d1 migrations apply blog-db --local",
    "d1:apply:remote": "wrangler d1 migrations apply blog-db --remote",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/markdoc": "^1.0.5",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@keystatic/astro": "^5.0.0",
    "@keystatic/core": "^0.5.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "astro": "^6.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260519.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.0",
    "daisyui": "^5.0.0",
    "pagefind": "^1.2.0",
    "tailwindcss": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
