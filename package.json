{
	"name": "portfolio-blog",
	"type": "module",
	"version": "0.1.0",
	"packageManager": "pnpm@12.11.2",
	"emdash": {
		"seed": "seed/seed.json"
	},
	"engines": {
		"node": ">=24.16.0"
	},
	"scripts": {
		"dev": "ASTRO_NODE_DEV=true dotenv -e .dev.vars -- astro dev",
		"build": "wrangler types && astro build && node ./scripts/post-build.mjs",
		"build:astro": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"wrangler:dev": "dotenv -e .dev.vars -- pnpm build && wrangler dev",
		"wrangler:deploy": "pnpm build && wrangler deploy",
		"d1:apply:local": "wrangler d1 migrations apply portfolio-blog --local",
		"d1:apply:remote": "wrangler d1 migrations apply portfolio-blog --remote",
		"typecheck": "astro check",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:subscriptions": "node scripts/test-subscription-cleanup.mjs",
		"test:telemetry": "node scripts/test-telemetry.mjs",
		"test:indexnow": "node scripts/test-indexnow.mjs",
		"cms:migrate-sanity": "node scripts/migrate-sanity-to-emdash.mjs",
		"cms:adopt": "node scripts/cms-adopt-emdash-features.mjs",
		"test:ui-keys": "node scripts/sync-ui-keys.mjs --check",
		"ui-keys:sync": "node scripts/sync-ui-keys.mjs",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/cloudflare": "^14.3.4",
		"@astrojs/node": "^11.1.7",
		"@astrojs/react": "^7.0.1",
		"@astrojs/rss": "^4.0.19",
		"@emdash-cms/cloudflare": "1.3.1",
		"@modelcontextprotocol/server": "^2.3.1",
		"@portfolio-blog/emdash-site": "link:./plugins/emdash-site",
		"@react-email/editor": "1.7.12",
		"astro": "^7.3.8",
		"astro-portabletext": "^1.0.1",
		"emdash": "1.3.1",
		"evlog": "2.30.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sharp": "^0.35.5",
		"shiki": "^4.5.0",
		"styled-components": "^6.5.3",
		"typescript": "^6.0.3",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261011.1",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@commitlint/format": "^21.2.3",
		"@commitlint/types": "^21.2.3",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro-eslint-parser": "^3.2.0",
		"daisyui": "^5.7.47",
		"dotenv-cli": "^11.0.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.1",
		"tailwindcss": "^4.3.3",
		"typescript-eslint": "^8.71.1",
		"wrangler": "^4.149.0"
	},
	"lint-staged": {
		"*.{js,cjs,mjs,ts,tsx,mts,astro}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,jsonc,yml,yaml,css,md}": [
			"prettier --write"
		]
	}
}
