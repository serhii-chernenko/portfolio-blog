{
	"name": "portfolio-blog",
	"type": "module",
	"version": "0.1.0",
	"packageManager": "pnpm@11.5.0",
	"engines": {
		"node": ">=24.16.0"
	},
	"scripts": {
		"dev": "PUBLIC_KEYSTATIC_MODE=local dotenv -e .dev.vars -- astro dev",
		"build": "wrangler types && astro build && pagefind --site dist/client/blog --output-path dist/client/blog/pagefind && node ./scripts/post-build.mjs",
		"build:astro": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"wrangler:dev": "dotenv -e .dev.vars -- sh -c \"pnpm build && astro preview\"",
		"wrangler:deploy": "pnpm build && wrangler deploy",
		"d1:apply:local": "wrangler d1 migrations apply portfolio-blog --local",
		"d1:apply:remote": "wrangler d1 migrations apply portfolio-blog --remote",
		"typecheck": "PUBLIC_KEYSTATIC_MODE=local astro check",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:subscriptions": "node scripts/test-subscription-cleanup.mjs",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/cloudflare": "^14.1.7",
		"@astrojs/markdoc": "^2.0.6",
		"@astrojs/node": "^11.0.3",
		"@astrojs/react": "^6.0.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@keystatic/astro": "^5.2.0",
		"@keystatic/core": "^0.5.0",
		"@react-email/editor": "1.4.1",
		"astro": "^7.1.6",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"sharp": "^0.34.3",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260519.1",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@commitlint/format": "^21.2.0",
		"@commitlint/types": "^21.2.0",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.0.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"astro-eslint-parser": "^3.0.0",
		"daisyui": "^5.0.0",
		"dotenv-cli": "^11.0.0",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"pagefind": "^1.2.0",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"tailwindcss": "^4.0.0",
		"typescript-eslint": "^8.65.0",
		"wrangler": "^4.95.0"
	},
	"lint-staged": {
		"*.{js,cjs,mjs,ts,tsx,mts,astro}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,jsonc,yml,yaml,css,md}": [
			"prettier --write"
		]
	}
}
