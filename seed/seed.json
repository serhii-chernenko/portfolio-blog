{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"defaultLocale": "en",
	"meta": {
		"name": "Serhii Chernenko — blog",
		"description": "Content model of the bilingual (en/uk) portfolio blog, migrated from Sanity.",
		"author": "Serhii Chernenko"
	},
	"settings": {
		"title": "Chernenko",
		"tagline": "Notes on engineering, photography, and craft."
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"description": "Blog articles. One entry per language; link translations from the Translations panel.",
			"icon": "article",
			"sortOrder": 1,
			"supports": ["drafts", "revisions", "preview", "scheduling", "search"],
			"titleField": "title",
			"admin": {
				"listColumns": ["description"]
			},
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true,
					"validation": {
						"maxLength": 120
					}
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "text",
					"required": true,
					"searchable": true,
					"validation": {
						"minLength": 50,
						"maxLength": 200
					},
					"options": {
						"helpText": "50–200 characters. Post listings, RSS, social cards and the meta description."
					}
				},
				{
					"slug": "revised_at",
					"label": "Updated at",
					"type": "datetime",
					"options": {
						"helpText": "Set it for meaningful edits; it shows as \"Updated …\" on the post page."
					}
				},
				{
					"slug": "tags",
					"label": "Tags",
					"type": "json",
					"widget": "field-kit:tags",
					"options": {
						"placeholder": "Add a tag…",
						"transform": "trim",
						"allowCustom": true,
						"helpText": "Free-form labels in this post's language. Each tag gets a page at /blog/{locale}/tags/{slug}."
					}
				},
				{
					"slug": "hero_image",
					"label": "Hero image",
					"type": "image",
					"options": {
						"helpText": "Optional. Cropped to 16:9 in cards. Fill in the alt text whenever an image is set."
					}
				},
				{
					"slug": "body",
					"label": "Body",
					"type": "portableText",
					"searchable": true,
					"options": {
						"helpText": "H1 is the post title: use H2 for sections, H3/H4 below. Type / for images, code, callouts and YouTube."
					}
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"description": "Static pages (about, privacy, support), served at /blog/{locale}/{slug}.",
			"icon": "file-text",
			"sortOrder": 2,
			"supports": ["drafts", "revisions", "preview", "search"],
			"urlPattern": "/{slug}",
			"titleField": "title",
			"admin": {
				"listColumns": ["key", "category"]
			},
			"fields": [
				{
					"slug": "key",
					"label": "Key",
					"type": "string",
					"required": true,
					"indexed": true,
					"translatable": false,
					"validation": {
						"pattern": "^[a-z0-9-]+$",
						"maxLength": 96
					},
					"options": {
						"helpText": "Stable identifier shared by all translations, for example about. Code and menus look pages up by key."
					}
				},
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true,
					"validation": {
						"maxLength": 120
					}
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "text",
					"required": true,
					"searchable": true,
					"validation": {
						"minLength": 50,
						"maxLength": 200
					}
				},
				{
					"slug": "category",
					"label": "Category",
					"type": "select",
					"translatable": false,
					"defaultValue": "static",
					"validation": {
						"options": ["static", "legal"]
					}
				},
				{
					"slug": "revised_at",
					"label": "Updated at",
					"type": "datetime"
				},
				{
					"slug": "body",
					"label": "Body",
					"type": "portableText",
					"searchable": true
				}
			]
		},
		{
			"slug": "site_settings",
			"label": "Site settings",
			"labelSingular": "Site settings",
			"description": "One entry per language: site name, tagline, description and the home page copy. Empty fields fall back to src/i18n/ui.ts.",
			"icon": "gear",
			"sortOrder": 3,
			"group": "Site",
			"routable": false,
			"supports": ["drafts", "revisions"],
			"titleField": "site_name",
			"admin": {
				"quickCreate": false
			},
			"fields": [
				{
					"slug": "site_name",
					"label": "Site name",
					"type": "string"
				},
				{
					"slug": "tagline",
					"label": "Tagline",
					"type": "string"
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "text"
				},
				{
					"slug": "hero_eyebrow",
					"label": "Hero eyebrow",
					"type": "string"
				},
				{
					"slug": "hero_title",
					"label": "Hero title",
					"type": "string"
				},
				{
					"slug": "hero_subtitle",
					"label": "Hero subtitle",
					"type": "text"
				},
				{
					"slug": "about_title",
					"label": "About title",
					"type": "string"
				},
				{
					"slug": "about_body",
					"label": "About body",
					"type": "text"
				},
				{
					"slug": "about_cta",
					"label": "About call to action",
					"type": "string"
				},
				{
					"slug": "default_og_image",
					"label": "Default social image",
					"type": "image",
					"translatable": false
				}
			]
		},
		{
			"slug": "ui_strings",
			"label": "UI strings",
			"labelSingular": "UI string",
			"description": "Overrides of interface text from src/i18n/ui.ts, one entry per key and language. Keep {placeholders} such as {year} unchanged. Emails and API confirmation pages always use the built-in text.",
			"icon": "translate",
			"sortOrder": 4,
			"group": "Site",
			"routable": false,
			"supports": ["drafts", "revisions"],
			"titleField": "key",
			"admin": {
				"listColumns": ["value"]
			},
			"fields": [
				{
					"slug": "key",
					"label": "Key",
					"type": "select",
					"required": true,
					"translatable": false,
					"validation": {
						"options": [
							"nav.posts",
							"nav.search",
							"nav.menu",
							"nav.skip",
							"theme.toggle",
							"lang.switch",
							"home.hero.ctaPosts",
							"home.hero.ctaSubscribe",
							"home.latest",
							"home.viewAll",
							"home.tags",
							"post.readingTime",
							"post.draft",
							"post.tags",
							"post.toc",
							"post.empty",
							"post.readMore",
							"subscribe.title",
							"subscribe.description",
							"subscribe.email",
							"subscribe.submit",
							"subscribe.submitting",
							"subscribe.success",
							"subscribe.invalid",
							"subscribe.rateLimited",
							"subscribe.error",
							"subscribe.confirm.body",
							"subscribe.confirm.invalid",
							"subscribe.confirm.error",
							"subscribe.unsubscribe.title",
							"subscribe.unsubscribe.description",
							"subscribe.unsubscribe.intro",
							"subscribe.unsubscribe.current",
							"subscribe.unsubscribe.language.en",
							"subscribe.unsubscribe.language.uk",
							"subscribe.unsubscribe.enabled",
							"subscribe.unsubscribe.disabled",
							"subscribe.unsubscribe.legend",
							"subscribe.unsubscribe.action.en",
							"subscribe.unsubscribe.action.uk",
							"subscribe.unsubscribe.action.all",
							"subscribe.unsubscribe.action.subscribeAll",
							"subscribe.unsubscribe.result.en",
							"subscribe.unsubscribe.result.uk",
							"subscribe.unsubscribe.result.all",
							"subscribe.unsubscribe.result.subscribeAll",
							"subscribe.unsubscribe.invalid.title",
							"subscribe.unsubscribe.invalid",
							"subscribe.unsubscribe.error.title",
							"subscribe.unsubscribe.error.body",
							"search.title",
							"search.placeholder",
							"search.close",
							"search.hint",
							"search.loading",
							"search.empty",
							"search.error",
							"search.results",
							"preview.exit",
							"comments.title",
							"tags.title",
							"tags.empty",
							"tag.title",
							"tag.empty",
							"404.title",
							"404.body",
							"404.cta",
							"footer.copyright",
							"pagination.previous",
							"pagination.next",
							"pagination.page"
						]
					}
				},
				{
					"slug": "value",
					"label": "Text",
					"type": "string",
					"required": true
				}
			]
		}
	]
}
