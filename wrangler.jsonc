// ============================================================================
//  Wrangler config — Cloudflare Workers deployment for the blog app.
// ============================================================================
//
//  ── Required public vars (declared below under "vars") ──
//    MAIL_FROM                             Sender address. Must be on a domain with
//                                          Cloudflare Email Routing enabled.
//    PUBLIC_KEYSTATIC_GITHUB_APP_SLUG      The "slug" of the GitHub App that backs
//                                          Keystatic — the part after `/apps/` in
//                                          https://github.com/apps/<slug>.
//
//  ── Required secrets (set via `wrangler secret put`) ──
//    SUBSCRIBE_RATE_LIMIT_SECRET           32-byte random — derives opaque
//                                          subscription tokens and abuse hashes.
//    TELEGRAM_BOT_TOKEN                    Optional in dev. Required in prod for
//                                          notifications.
//    TELEGRAM_CHAT_ID                      Optional in dev. Required in prod.
//    KEYSTATIC_SECRET                      32-byte random — signs Keystatic auth
//                                          cookies. Required for prod GitHub mode.
//    KEYSTATIC_GITHUB_CLIENT_ID            GitHub App client ID (prod GitHub mode).
//    KEYSTATIC_GITHUB_CLIENT_SECRET        GitHub App client secret (prod GitHub mode).
//
//  Set them all in one go (see docs/KEYSTATIC.md for the GitHub App setup):
//
//    pnpm wrangler secret put SUBSCRIBE_RATE_LIMIT_SECRET
//    pnpm wrangler secret put TELEGRAM_BOT_TOKEN
//    pnpm wrangler secret put TELEGRAM_CHAT_ID
//    pnpm wrangler secret put KEYSTATIC_SECRET
//    pnpm wrangler secret put KEYSTATIC_GITHUB_CLIENT_ID
//    pnpm wrangler secret put KEYSTATIC_GITHUB_CLIENT_SECRET
//
//  ── Required bindings ──
//    DB           D1 database. Replace database_id with the value from
//                 `wrangler d1 create portfolio-blog`.
//    ASSETS       Static assets bound from ./dist (set automatically).
//    SEND_EMAIL   Cloudflare Email Service binding. Requires Email Routing to
//                 be enabled on the sender domain.
//    ANALYTICS    Analytics Engine dataset (portfolio_blog_events). No separate
//                 provisioning step — Cloudflare creates the dataset on
//                 the first writeDataPoint() call. Used for server-side
//                 newsletter funnel metrics (subscribe / confirm / unsubscribe).
//                 Query via: POST https://api.cloudflare.com/client/v4/accounts/
//                 <account_id>/analytics_engine/sql  (bearer token required:
//                 "Account Analytics: Read" permission). ~3 month retention.
//                 NOTE: writeDataPoint() is a no-op in plain `wrangler dev`
//                 (Cloudflare issue #4258); use --remote to test locally.
//
// ============================================================================
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-blog",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"preview_urls": true,
	"compatibility_date": "2026-05-15",
	"compatibility_flags": ["nodejs_compat"],
	// Astro v13 Cloudflare build emits static assets to ./dist/client and the
	// Worker code to ./dist/server. Scope ASSETS to ./dist/client ONLY — never
	// ./dist — so server-side files (notably dist/server/.dev.vars, which the
	// adapter writes from the local .dev.vars at build time) are NEVER uploaded
	// or served as public static assets.
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio-blog",
			"database_id": "3203b8f1-e6c5-4db7-bdb1-1651b33fb67f",
			"migrations_dir": "./schema",
		},
	],
	"send_email": [
		{
			"name": "SEND_EMAIL",
		},
	],
	// Analytics Engine — server-side newsletter funnel metrics.
	// Dataset is auto-created on first write; no dashboard (query via SQL API).
	// Dimensions written: event name, locale, source, status — NO PII ever.
	// After adding/changing this block, run `pnpm exec wrangler types` to
	// regenerate worker-configuration.d.ts with the ANALYTICS binding typed.
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "portfolio_blog_events",
		},
	],
	"observability": {
		"enabled": true,
		// Bearer capabilities are carried in query strings for email-client
		// compatibility. Keep custom structured logs but suppress automatic
		// per-request invocation logs so those URLs are not retained there.
		"logs": {
			"invocation_logs": false,
		},
	},
	// `wrangler dev` defaults its simulated host to the first entry in `routes`
	// (production), which makes `request.url` resolve to www.serhiichernenko.com
	// even when serving from localhost. Forcing the dev host to localhost makes
	// request.url match where the browser actually is — so things like
	// self-referential confirm links work without any env-var indirection.
	"dev": {
		"host": "localhost:8787",
	},
	// Route topology — canonical host is www.serhiichernenko.com.
	//
	//   www…/blog          → blog landing
	//   www…/blog/*        → all blog routes (incl. /blog/keystatic UI)
	//   www…/api/keystatic, www…/api/keystatic/*
	//                       → host-root Keystatic API. The shipped Keystatic
	//                         React UI fetches these absolute paths;
	//                         src/middleware.ts rewrites them to
	//                         /blog/api/keystatic/* so Astro (base: '/blog')
	//                         can serve them.
	//
	// `zone_name` stays the apex (serhiichernenko.com) — that is the Cloudflare
	// zone the www hostname lives in; the route *pattern* is what binds to www.
	//
	// The bare apex serhiichernenko.com is NOT bound to this Worker. A Cloudflare
	// Redirect Rule (dashboard → Rules → Redirect Rules) 301s the apex → www, so
	// visitors who type the bare domain land on the canonical www host. The
	// host root `/` (on either host) is intentionally unbound — it falls through
	// to the 100:: placeholder and errors for now. This domain uses path-based
	// routing across MULTIPLE Workers (one per app, separate repos): a future
	// portfolio Worker — its own repo, a from-scratch rewrite of the old
	// chernenko.digital — will claim the root `/`. It can bind a catch-all
	// `www.serhiichernenko.com/*`; these `/blog*` + `/api/keystatic*` routes are
	// more specific and keep winning (Cloudflare most-specific-route-wins). So do
	// NOT add a `/` → `/blog` redirect here — the root belongs to the portfolio.
	//
	// `/robots.txt` is the one narrow exception: Astro only emits `public/` under
	// the `/blog` base, so without this route the host-root file 522s (nothing is
	// bound there) and crawlers never see it. Bound at an exact path — NOT a `/*`
	// catch-all — so it stays out of the future portfolio Worker's way; ownership
	// moves to that Worker (and this route is deleted) once it exists. See
	// docs/DNS-ROUTING.md.
	"routes": [
		{
			"pattern": "www.serhiichernenko.com/blog",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "www.serhiichernenko.com/blog/*",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "www.serhiichernenko.com/api/keystatic",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "www.serhiichernenko.com/api/keystatic/*",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "www.serhiichernenko.com/keystatic",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "www.serhiichernenko.com/keystatic/*",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "www.serhiichernenko.com/robots.txt",
			"zone_name": "serhiichernenko.com",
		},
	],
	// Public (non-secret) vars. These are inlined into the deployed Worker bundle
	// and are safe to expose. Anything sensitive belongs in `wrangler secret put`.
	"vars": {
		// MAIL_FROM must be on a domain with Cloudflare Email Routing enabled
		// AND a verified sender for that exact address. Until Email Routing +
		// sender verification are configured on serhiichernenko.com, outbound
		// email will fail. Set it up in the CF dashboard before relying on
		// production sends.
		"MAIL_FROM": "hello@serhiichernenko.com",
		"PUBLIC_KEYSTATIC_GITHUB_APP_SLUG": "serhii-chernenko-portfolio-blog",
	},
}
