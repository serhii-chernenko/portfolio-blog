// ============================================================================
//  Wrangler config — Cloudflare Workers deployment for the blog app.
// ============================================================================
//
//  ── Required public vars (declared below under "vars") ──
//    MAIL_FROM                             Sender address. Must be on a domain with
//                                          Cloudflare Email Routing enabled.
//    EMDASH_SITE_URL                       Public origin of the CMS (passkeys,
//                                          admin redirects).
//
//  ── Required secrets (set via `wrangler secret put`) ──
//    SUBSCRIBE_RATE_LIMIT_SECRET           32-byte random — derives opaque
//                                          subscription tokens and abuse hashes.
//    TELEGRAM_BOT_TOKEN                    Optional in dev. Required in prod for
//                                          notifications.
//    TELEGRAM_CHAT_ID                      Optional in dev. Required in prod.
//
//  Set them all in one go:
//
//    pnpm wrangler secret put SUBSCRIBE_RATE_LIMIT_SECRET
//    pnpm wrangler secret put TELEGRAM_BOT_TOKEN
//    pnpm wrangler secret put TELEGRAM_CHAT_ID
//
//  ── Optional CMS secret (EmDash) ──
//    EMDASH_ENCRYPTION_KEY                 Encrypts plugin secret settings stored
//                                          in the CMS database. Only needed if a
//                                          plugin declares secret settings (none
//                                          do today). Generate with
//                                          `pnpm exec emdash secrets generate`
//                                          and keep a protected backup: losing
//                                          it makes those values unreadable.
//
//  ── Optional secret (observability) ──
//    NEW_RELIC_LICENSE_KEY                 New Relic ingest license key. Forwards
//                                          visitor and newsletter telemetry
//                                          events to New Relic; without it,
//                                          events are only written to Workers
//                                          logs (docs/OBSERVABILITY.md).
//
//    pnpm wrangler secret put NEW_RELIC_LICENSE_KEY
//
//  ── Required bindings ──
//    DB           D1 database. Replace database_id with the value from
//                 `wrangler d1 create portfolio-blog`.
//    CMS_DB       D1 database of the EmDash CMS (content, schema, users,
//                 menus). Kept apart from DB so CMS backups and restores never
//                 touch subscriber data. EmDash applies its own migrations on
//                 the first request (docs/CMS.md).
//    MEDIA        R2 bucket with the CMS media library (images uploaded in
//                 the admin, served at /_emdash/api/media/file/...).
//    SESSION      KV namespace for EmDash admin sessions. Not declared here:
//                 the Cloudflare adapter adds it at build time.
//    ASSETS       Static assets bound from ./dist (set automatically).
//    SEND_EMAIL   Cloudflare Email Service binding. Requires Email Routing to
//                 be enabled on the sender domain.
//    ANALYTICS    Analytics Engine dataset (portfolio_blog_events). No separate
//                 provisioning step — Cloudflare creates the dataset on
//                 the first writeDataPoint() call. Used for server-side
//                 newsletter funnel metrics (subscribe / confirm / unsubscribe).
//                 Query via: POST https://api.cloudflare.com/client/v4/accounts/
//                 <account_id>/analytics_engine/sql  (bearer token required:
//                 "Account Analytics: Read" permission). ~3 month retention.
//                 NOTE: writeDataPoint() is a no-op in plain `wrangler dev`
//                 (Cloudflare issue #4258); use --remote to test locally.
//
// ============================================================================
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-blog",
	// Astro handler + EmDash's scheduled handler (src/worker.ts).
	"main": "./src/worker.ts",
	"preview_urls": true,
	"compatibility_date": "2026-05-15",
	"compatibility_flags": ["nodejs_compat"],
	// Astro v13 Cloudflare build emits static assets to ./dist/client and the
	// Worker code to ./dist/server. Scope ASSETS to ./dist/client ONLY — never
	// ./dist — so server-side files (notably dist/server/.dev.vars, which the
	// adapter writes from the local .dev.vars at build time) are NEVER uploaded
	// or served as public static assets.
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio-blog",
			"database_id": "3203b8f1-e6c5-4db7-bdb1-1651b33fb67f",
			"migrations_dir": "./schema",
		},
		{
			"binding": "CMS_DB",
			"database_name": "portfolio-blog-cms",
			"database_id": "2ffe316d-927f-4c83-acce-5f0ff72e893b",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "portfolio-blog-media",
		},
	],
	// Runs EmDash scheduled publishing and maintenance (createScheduledHandler).
	"triggers": {
		"crons": ["* * * * *"],
	},
	"send_email": [
		{
			"name": "SEND_EMAIL",
		},
	],
	// Analytics Engine — server-side newsletter funnel metrics.
	// Dataset is auto-created on first write; no dashboard (query via SQL API).
	// Dimensions written: event name, locale, source, status — NO PII ever.
	// After adding/changing this block, run `pnpm exec wrangler types` to
	// regenerate worker-configuration.d.ts with the ANALYTICS binding typed.
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "portfolio_blog_events",
		},
	],
	"cache": {
		"enabled": true,
	},
	// Smart Placement: on a cache miss the Worker runs near the D1 primary (WEUR) instead of near
	// the visitor. A page render makes dozens of sequential D1 queries, ~37 ms each from a distant
	// colo. Cache hits are unaffected: Workers Cache is checked near the visitor before placement.
	"placement": {
		"mode": "smart",
	},
	"ratelimits": [
		{
			"name": "EVENTS_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60,
			},
		},
	],
	"observability": {
		"enabled": true,
		// Bearer capabilities are carried in query strings for email-client
		// compatibility. Keep custom structured logs but suppress automatic
		// per-request invocation logs so those URLs are not retained there.
		"logs": {
			"invocation_logs": false,
		},
	},
	// `wrangler dev` defaults its simulated host to the first entry in `routes`
	// (production), which makes `request.url` resolve to serhiichernenko.com
	// even when serving from localhost. Forcing the dev host to localhost makes
	// request.url match where the browser actually is — so things like
	// self-referential confirm links work without any env-var indirection.
	"dev": {
		"host": "localhost:8787",
	},
	// Route topology — canonical host is the bare apex serhiichernenko.com.
	// www.serhiichernenko.com is not bound: a Cloudflare Redirect Rule 308s it to
	// the apex before Workers run (docs/DNS-ROUTING.md).
	//
	//   …/blog             → blog landing
	//   …/blog/*           → all blog routes
	//   …/_emdash/*        → EmDash admin, API and media
	//
	// `zone_name` is the apex (serhiichernenko.com) — the Cloudflare zone; the
	// route *pattern* is what selects the host.
	//
	// The apex host root `/` is intentionally unbound — a Redirect Rule 302s it
	// to /blog/en/ until the portfolio Worker exists. This domain uses path-based
	// routing across MULTIPLE Workers (one per app, separate repos): a future
	// portfolio Worker — its own repo, a from-scratch rewrite of the old
	// chernenko.digital — will claim the root `/`. It can bind a catch-all
	// `serhiichernenko.com/*`; these `/blog*` routes are
	// more specific and keep winning (Cloudflare most-specific-route-wins). So do
	// NOT add a `/` → `/blog` redirect here — the root belongs to the portfolio.
	//
	// `/robots.txt` is the one narrow exception: crawlers only read robots.txt at the
	// host root. Bound at an exact path — NOT a `/*` catch-all — so it stays out of the
	// future portfolio Worker's way; ownership moves to that Worker (and this route is
	// deleted) once it exists. EmDash serves it from the admin (Settings → SEO). See
	// docs/DNS-ROUTING.md.
	"routes": [
		{
			"pattern": "serhiichernenko.com/blog",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "serhiichernenko.com/blog/*",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "serhiichernenko.com/robots.txt",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "serhiichernenko.com/favicon.ico",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "serhiichernenko.com/llms.txt",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "serhiichernenko.com/llms-full.txt",
			"zone_name": "serhiichernenko.com",
		},
		{
			"pattern": "serhiichernenko.com/sitemap.xml",
			"zone_name": "serhiichernenko.com",
		},
		// EmDash admin (`/_emdash/admin`) and its API. The admin client calls these
		// host-root paths, so they cannot live under /blog (docs/CMS.md).
		{
			"pattern": "serhiichernenko.com/_emdash/*",
			"zone_name": "serhiichernenko.com",
		},
	],
	// Public (non-secret) vars. These are inlined into the deployed Worker bundle
	// and are safe to expose. Anything sensitive belongs in `wrangler secret put`.
	"vars": {
		// MAIL_FROM must be on a domain with Cloudflare Email Routing enabled
		// AND a verified sender for that exact address. Until Email Routing +
		// sender verification are configured on serhiichernenko.com, outbound
		// email will fail. Set it up in the CF dashboard before relying on
		// production sends.
		"MAIL_FROM": "hello@serhiichernenko.com",
		// Public origin of the CMS: passkeys, admin redirects, MCP discovery and
		// plugin site URLs. For `pnpm wrangler:dev`, override it in .dev.vars with
		// http://localhost:8787 to sign in locally.
		"EMDASH_SITE_URL": "https://serhiichernenko.com",
	},
}
