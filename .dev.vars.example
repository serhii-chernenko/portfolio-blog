# =============================================================================
# Local development environment — the SINGLE env file for local dev.
# Copy to `.dev.vars` (gitignored), then fill in what you need:
#
#   cp .dev.vars.example .dev.vars
#
# Both local commands read this one file (no `.env` involved):
#   • pnpm dev          Astro dev server on the Node adapter (the email
#                       template admin needs fs). dotenv-cli loads this file into
#                       process.env: PUBLIC_* client vars are inlined via
#                       astro:env/client, and server secrets are read via
#                       astro:env/server (which reads process.env in dev).
#   • pnpm wrangler:dev Local Worker emulation (workerd). The build step is
#                       wrapped with dotenv-cli so PUBLIC_* vars get inlined at
#                       build time, and the Worker runtime reads this file's
#                       secrets natively (astro:env getSecret / cloudflare:workers).
#
# Production never uses this file: runtime secrets are set via
# `wrangler secret put <NAME>`; public/build vars come from CI env.
#
# NOT here: MAIL_FROM lives in wrangler.jsonc `vars` (exposed to local dev
# automatically). ASTRO_NODE_DEV is set inline on the `pnpm dev` script only —
# it MUST stay unset for wrangler:dev and production so the Worker build uses
# the Cloudflare adapter.
# =============================================================================

# ── Runtime secrets — read from Astro.locals.runtime.env (dev) / wrangler (wrangler:dev) ──

# REQUIRED — any non-empty string works locally. Use a real 32-byte random in prod.
SUBSCRIBE_RATE_LIMIT_SECRET=local-dev-only-secret-replace-in-prod

# Optional locally — leave empty to skip notifications. notify() no-ops gracefully.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Sanity Viewer token. Enables draft mode / Visual Editing via the
# Studio Presentation tool. Empty → only published content, draft mode disabled.
SANITY_API_READ_TOKEN=

# Optional — secret of the Sanity webhook that purges the Workers Cache.
SANITY_WEBHOOK_SECRET=

# Optional — HMAC key (32+ chars) signing the draft-session cookie. Draft mode
# needs it together with SANITY_API_READ_TOKEN. Generate: openssl rand -hex 32
DRAFT_MODE_COOKIE_SECRET=

# ── Public build-time vars — inlined into the bundle via import.meta.env ──
# All optional locally; features no-op when empty (comments widget, analytics).

# Giscus comments (https://giscus.app). Empty → comments widget is hidden.
PUBLIC_GISCUS_REPO=serhii-chernenko/portfolio-blog
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=

# Cloudflare Web Analytics is auto-injected by Cloudflare's edge (auto-install
# enabled for the serhiichernenko.com zone) — no token or env var needed here.
