# Copy to `.dev.vars` (gitignored) before `pnpm wrangler:dev`.
# These values are read by wrangler at startup and exposed as Cloudflare-runtime
# secrets. In production, set the equivalents via `wrangler secret put <NAME>`.

# REQUIRED — any non-empty string works locally. Use a real 32-byte random in prod.
SUBSCRIBE_RATE_LIMIT_SECRET=local-dev-only-secret-replace-in-prod

# Optional locally — leave empty to skip notifications. notify() no-ops gracefully.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Keystatic GitHub mode — REQUIRED for `pnpm wrangler:dev` (the Worker runtime
# can't use Keystatic local storage; only `pnpm dev` can do that). Get the
# values from your GitHub App; see docs/KEYSTATIC.md. Same values are set in
# production via `wrangler secret put`.
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
