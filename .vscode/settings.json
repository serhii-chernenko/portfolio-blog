{
	"files.associations": {
		"wrangler.jsonc": "jsonc",
		".dev.vars": "properties",
		".dev.vars.example": "properties"
	},
	"[astro]": {
		"editor.defaultFormatter": "astro-build.astro-vscode"
	},
	"[mdx]": {
		"editor.defaultFormatter": "unifiedjs.vscode-mdx"
	},
	"editor.tabSize": 2,
	"editor.insertSpaces": false,
	"editor.formatOnSave": false,
	"tailwindCSS.experimental.classRegex": [["class:list=\"([^\"]*)\"", "[^\"]+"]],
	"tailwindCSS.includeLanguages": {
		"astro": "html"
	},
	"emmet.includeLanguages": {
		"astro": "html"
	},
	"cSpell.words": [
		"astro",
		"astrojs",
		"chernenko",
		"daisyui",
		"groq",
		"prerender",
		"unixepoch",
		"giscus",
		"shiki",
		"wrangler",
		"sanity",
		"emdash",
		"hreflang",
		"FOUC",
		"webp",
		"avif",
		"cloudflare",
		"workerd"
	],
	"cSpell.language": "en,uk"
}
